# ============================================
# 敏感文件与环境缓存
# ============================================
.env
.env.*
!.env.example

# 模型管理配置（含云端 API Key，绝不能提交到公开仓库）
model_config.json
model_config.json.*

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# Frontend (dist 目录保留用于开箱即用)
!frontend/dist/
!frontend/dist/**

# 编辑器
.idea/
.vscode/
.workbuddy/
*.swp
*.swo
.DS_Store
Thumbs.db

# 临时日志与导出报告
*.log
