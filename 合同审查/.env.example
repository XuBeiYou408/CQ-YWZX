# ============================================
# 合同审查 AGENT · 环境变量配置范本 (.env.example)
# ============================================

# 服务端口与绑定地址
HOST=0.0.0.0
PORT=8020

# LM Studio / 本地大模型服务配置 (默认 127.0.0.1:1234/v1)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=lm-studio

# 审查所用模型（2026-09-17 起内置默认已固定为 google/gemma-4-e4b）
# 注意：本项目代码不加载 .env（config.py 直接读 os.getenv），
#       因此这里的值只在「真正设到进程环境变量」时才生效
#       （例如 mcp.json 的 env 块、一键启动.bat 里 set、或系统环境变量）。
DEFAULT_MODEL=google/gemma-4-e4b
AGENT_MODEL=google/gemma-4-e4b
